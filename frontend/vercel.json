{
    "redirects": [
        {
            "source": "/products/jsr-steem-rice",
            "destination": "/products/jsr-steam-rice",
            "permanent": true
        }
    ],
    "headers": [
        {
            "source": "/admin/:path*",
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex, nofollow, noarchive"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/sitemap.xml",
            "destination": "/api/sitemap"
        },
        {
            "source": "/admin/:path*",
            "destination": "/index.html"
        },
        {
            "source": "/card/:path*",
            "destination": "/index.html"
        },
        {
            "source": "/products/:path*",
            "destination": "/index.html"
        }
    ]
}
