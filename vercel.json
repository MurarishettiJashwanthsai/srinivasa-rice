{
  "version": 2,
  "redirects": [
    {
      "source": "/products/jsr-steem-rice",
      "destination": "/products/jsr-steam-rice",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/mobile-turnstile",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/card/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/mobile-turnstile",
      "destination": "/index.html"
    }
  ]
}
