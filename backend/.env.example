DATABASE_URL=sqlite:///./market_data.db
SECRET_KEY=replace_with_a_secure_random_jwt_secret_in_production
ACCESS_TOKEN_HOURS=8
ADMIN_USERNAME=replace_with_admin_username
ADMIN_PASSWORD=replace_with_a_long_unique_admin_password
ADMIN_PASSWORD_MIN_LENGTH=14
ADMIN_COOKIE_SECURE=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
MAX_IMAGE_BYTES=5242880
SITE_URL=https://www.srinivascanvassing.com
CLOUDINARY_CLOUD_NAME=replace_with_cloudinary_cloud_name
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret
FRONTEND_URL=https://www.srinivascanvassing.com
# Optional: receives a JSON payload when a new quote or price-alert lead is saved.
LEAD_NOTIFICATION_WEBHOOK_URL=
# Optional: provider workflow that sends the RFQ reference to the buyer by email or WhatsApp.
CUSTOMER_CONFIRMATION_WEBHOOK_URL=
# Optional together: Cloudflare Turnstile keys are configured separately in backend and frontend.
TURNSTILE_SECRET_KEY=
